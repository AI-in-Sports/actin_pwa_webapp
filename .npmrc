# Token for the Actin package registry comes from the environment; never commit it.
#   export NPM_ACTIN_TOKEN=...   (local dev and CI)
#   docker build --secret id=npm_token,env=NPM_ACTIN_TOKEN .   (images)
//packages.actinhealth.ir/npm/p/pwa/pwa/:_authToken=${NPM_ACTIN_TOKEN}
@actin:registry=https://packages.actinhealth.ir/npm/p/pwa/pwa/
always-auth=true
