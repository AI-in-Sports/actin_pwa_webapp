# Production image for the Actin PWA webapp.
#
# The build is memory-heavy (Nuxt 4 + Vite 8 + Tailwind 4). Node's default
# heap inside a container is ~2 GB, which is not enough. Raise it here. The
# GitHub Actions workflow passes --build-arg NODE_MAX_OLD_SPACE_SIZE=8192.
#
# Build locally:
#   NPM_ACTIN_TOKEN=... docker build \
#     --secret id=npm_token,env=NPM_ACTIN_TOKEN \
#     --build-arg NODE_MAX_OLD_SPACE_SIZE=8192 \
#     -t actin-pwa-webapp:local .

# syntax=docker/dockerfile:1
FROM node:24-alpine AS base

# pnpm 10 matches the lockfile generated by the repository's pnpm 10 toolchain.
RUN npm install -g pnpm@10

ARG APP_BACKEND DISABLE_RESERVATION

# 8 GB is the default for CI and production builds. Increase further with
# --build-arg NODE_MAX_OLD_SPACE_SIZE=12288 if a host has enough memory.
ARG NODE_MAX_OLD_SPACE_SIZE=8192

ENV APP_BACKEND=${APP_BACKEND} \
    DISABLE_RESERVATION=${DISABLE_RESERVATION} \
    NUXT_TELEMETRY_DISABLED=1 \
    NODE_OPTIONS="--max-old-space-size=${NODE_MAX_OLD_SPACE_SIZE}"

ENV NITRO_HOST=0.0.0.0 \
    NITRO_PORT=3000

FROM base AS deps

WORKDIR /app

COPY package.json pnpm-lock.yaml .npmrc ./

# The registry token is mounted only for this step and written to the user-level
# npmrc (pnpm 10.34+ ignores env-expanded credentials in a project .npmrc).
# It is removed again before the layer is committed.
RUN --mount=type=secret,id=npm_token,required=true \
    sh -c 'printf "//npm.pkg.github.com/:_authToken=%s\n" "$(cat /run/secrets/npm_token)" > "$HOME/.npmrc" \
      && pnpm install --frozen-lockfile \
      && rm -f "$HOME/.npmrc"'

FROM base AS builder

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules

COPY . .

RUN pnpm build

FROM base AS runner

WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder /app/.output ./.output

USER node

EXPOSE 3000

CMD ["node", ".output/server/index.mjs"]
