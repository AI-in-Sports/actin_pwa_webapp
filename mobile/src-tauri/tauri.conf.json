{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Actin",
  "version": "0.1.0",
  "identifier": "ir.actinhealth.app",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../.output/public",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm generate"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost https://*.actinhealth.ir http://localhost:* ws://localhost:*; img-src 'self' data: blob: https://*.actinhealth.ir; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "HealthcareAndFitness",
    "shortDescription": "Actin mirror results and sharing",
    "iOS": {
      "minimumSystemVersion": "14.0"
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
